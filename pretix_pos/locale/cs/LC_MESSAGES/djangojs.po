msgstr "Vyberte místa ke zrušení"

#: static/pretix_pos/pos.js
#, python-format
msgid "Clear %(n)s selected seat"
msgid_plural "Clear %(n)s selected seats"
msgstr[0] "Zrušit %(n)s vybrané místo"
msgstr[1] "Zrušit %(n)s vybraná místa"
msgstr[2] "Zrušit %(n)s vybraných míst"

#: static/pretix_pos/pos.js
#, python-format
msgid "Clearing %(n)s seat…"
msgid_plural "Clearing %(n)s seats…"
msgstr[0] "Ruší se %(n)s místo…"
msgstr[1] "Ruší se %(n)s místa…"
msgstr[2] "Ruší se %(n)s míst…"

#: static/pretix_pos/pos.js
#, python-format
msgid "Cleared %(n)s seat."
msgid_plural "Cleared %(n)s seats."
msgstr[0] "Zrušeno %(n)s místo."
msgstr[1] "Zrušena %(n)s místa."
msgstr[2] "Zrušeno %(n)s míst."

#: static/pretix_pos/pos.js
#, python-format
msgid "Cleared %(ok)s/%(n)s seat."
msgid_plural "Cleared %(ok)s/%(n)s seats."
msgstr[0] "Zrušeno %(ok)s/%(n)s místo."
msgstr[1] "Zrušeno %(ok)s/%(n)s místa."
msgstr[2] "Zrušeno %(ok)s/%(n)s míst."

#: static/pretix_pos/pos.js
msgid ""
"Clearing seats one by one - this is not a single atomic action, a failure "
"partway through leaves earlier removals in place…"
msgstr ""
"Místa se ruší jedno po druhém – není to jedna nedělitelná akce, při selhání "
"v půlce zůstanou dřívější zrušení provedená…"

#: static/pretix_pos/pos.js
#, python-format
msgid "Batch clearing failed (%(error)s) - retrying one by one…"
msgstr "Hromadné zrušení selhalo (%(error)s) – zkouším jedno po druhém…"

#: static/pretix_pos/pos.js
msgid "Scan to pay"
msgstr "Naskenujte pro platbu"

#: static/pretix_pos/pos.js
msgid "QR payment code"
msgstr "QR kód pro platbu"

#: static/pretix_pos/pos.js
msgid "Amount"
msgstr "Částka"

#: static/pretix_pos/pos.js
msgid "Account"
msgstr "Číslo účtu"

#: static/pretix_pos/pos.js
msgid "Variable symbol"
msgstr "Variabilní symbol"

#: static/pretix_pos/pos.js
msgid "Recipient"
msgstr "Příjemce"

#: static/pretix_pos/pos.js
msgid "Close"
msgstr "Zavřít"

#: static/pretix_pos/pos.js
msgid "Show QR code"
msgstr "Zobrazit QR kód"

#: static/pretix_pos/pos.js
msgid "Payment received"
msgstr "Platba dorazila"

#: static/pretix_pos/pos.js
msgid "Confirming…"
msgstr "Potvrzuji…"

#: static/pretix_pos/pos.js
msgid ""
"Waiting for the transfer - the order stays unpaid until the money arrives."
msgstr ""
"Čeká se na převod – objednávka zůstane nezaplacená, dokud peníze nedorazí."

#: static/pretix_pos/pos.js
msgid ""
"This payment has no QR code - check that the bank transfer provider is "
"configured for this event."
msgstr ""
"K této platbě není QR kód – zkontrolujte, že je pro tuto akci nastavená "
"platební metoda bankovním převodem."

#: static/pretix_pos/pos.js
msgid "Bank transfer"
msgstr "Bankovní převod"

#: static/pretix_pos/pos.js
#, python-format
msgid "Paid %(amount)s by %(method)s on %(date)s"
msgstr "Zaplaceno %(amount)s – %(method)s, %(date)s"

#: static/pretix_pos/pos.js
#, python-format
msgid "Valid until %(date)s"
msgstr "Platí do %(date)s"

#: static/pretix_pos/pos.js
msgid "Extend to the event date"
msgstr "Prodloužit do konání akce"

#: static/pretix_pos/pos.js
msgid "Extending…"
msgstr "Prodlužuji…"

#: static/pretix_pos/pos.js
msgid "Can't tell which date this order is for."
msgstr "Nelze zjistit, na který termín je objednávka."

#: static/pretix_pos/pos.js
#, python-format
msgid "Expired %(date)s - the seats are no longer held"
msgstr "Propadlo %(date)s – místa už nejsou držena"

#: static/pretix_pos/pos.js
msgid "Revive until the event date"
msgstr "Obnovit do konání akce"

#: static/pretix_pos/pos.js
msgid "Seat this product"
msgstr "Usadit tento produkt"

#: static/pretix_pos/pos.js
#, python-format
msgid "Seat this product (%(count)s)"
msgstr "Usadit tento produkt (%(count)s)"

#: static/pretix_pos/pos.js
msgid "Placing this — click seats"
msgstr "Usazuji tento — klikejte do mapy"

#: static/pretix_pos/pos.js
msgid "Click its seats on the map"
msgstr "Klikejte na jeho místa v mapě"

#: static/pretix_pos/pos.js
#, python-format
msgid "%(name)s — seated, pick a variant"
msgstr "%(name)s — se sezením, vyberte variantu"

#: static/pretix_pos/pos.js
#, python-format
msgid "Placing: %(name)s - the seating plan's own mapping is ignored"
msgstr "Usazuji: %(name)s – mapování plánu se ignoruje"

#: static/pretix_pos/pos.js
msgid "Back to the mapping"
msgstr "Zpět na mapování"

#: static/pretix_pos/pos.js
msgid ""
"This seat's category has no product mapped to it - choose a product with "
"“Seat this product” first."
msgstr ""
"Kategorie tohoto místa nemá namapovanou žádnou položku – zvolte nejdřív "
"produkt tlačítkem „Usadit tento produkt“."

#: static/pretix_pos/pos.js
#, python-format
msgid ""
"%(name)s has variants, so a seat can't tell which one - pick the variant with "
"“Seat this product” first."
msgstr ""
"%(name)s má varianty, takže z místa nelze poznat kterou – vyberte nejdřív "
"variantu tlačítkem „Usadit tento produkt“."

#: static/pretix_pos/pos.js
msgid "This seat can't be booked from here."
msgstr "Toto místo odsud nelze obsadit."

#: static/pretix_pos/pos.js
msgid ""
"Could not match every seat to its position - assign the missing ones in the "
"Edit order tab."
msgstr ""
"Nepodařilo se přiřadit každé místo k jeho pozici – zbytek přiřaďte v záložce "
"Upravit objednávku."

#: static/pretix_pos/pos.js
#, python-format
msgid ""
"The order was created, but %(count)s seat(s) could not be assigned "
"(%(error)s) - finish it in the Edit order tab."
msgstr ""
"Objednávka byla vytvořena, ale %(count)s míst se nepodařilo přiřadit "
"(%(error)s) – dokončete to v záložce Upravit objednávku."

#: static/pretix_pos/pos.js
#, python-format
msgid "%(count)s product with no seats in this plan"
msgid_plural "%(count)s products with no seats in this plan"
msgstr[0] "%(count)s produkt bez míst v tomto plánu"
msgstr[1] "%(count)s produkty bez míst v tomto plánu"
msgstr[2] "%(count)s produktů bez míst v tomto plánu"
