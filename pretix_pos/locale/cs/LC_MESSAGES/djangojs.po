#: pretix_pos/static/pretix_pos/pos.js:91
msgid "Cash"
msgstr "Hotovost"

#: pretix_pos/static/pretix_pos/pos.js:92
msgid "QR transfer"
msgstr "QR převod"

#: pretix_pos/static/pretix_pos/pos.js:93
msgid "Card"
msgstr "Karta"

#: pretix_pos/static/pretix_pos/pos.js:277
#: pretix_pos/static/pretix_pos/pos.js:1825
msgid "Unknown error."
msgstr "Neznámá chyba."

#: pretix_pos/static/pretix_pos/pos.js:316
msgid ""
"Unpair this terminal? You will need a new initialization token to reconnect."
msgstr ""
"Zrušit spárování tohoto terminálu? Pro opětovné připojení budete potřebovat "
"nový inicializační token."

#: pretix_pos/static/pretix_pos/pos.js:339
#: pretix_pos/static/pretix_pos/pos.js:1607
msgid "Total: %(amount)s"
msgstr "Celkem: %(amount)s"

#: pretix_pos/static/pretix_pos/pos.js:400
msgid "Connecting…"
msgstr "Připojování…"

#: pretix_pos/static/pretix_pos/pos.js:426
#: pretix_pos/static/pretix_pos/pos.js:458
msgid "Network error."
msgstr "Chyba sítě."

#: pretix_pos/static/pretix_pos/pos.js:440
msgid "Checking…"
msgstr "Kontrola…"

#: pretix_pos/static/pretix_pos/pos.js:443
msgid ""
"That code doesn't look valid, or this device was revoked - ask an "
"administrator to re-pair it."
msgstr ""
"Tento kód nevypadá platně, nebo bylo toto zařízení zrušeno - požádejte "
"administrátora o opětovné spárování."

#: pretix_pos/static/pretix_pos/pos.js:468
#: pretix_pos/static/pretix_pos/pos.js:2595
msgid "Loading…"
msgstr "Načítání…"

#: pretix_pos/static/pretix_pos/pos.js:471
msgid "Could not load events (%(error)s)."
msgstr "Nepodařilo se načíst akce (%(error)s)."

#: pretix_pos/static/pretix_pos/pos.js:476
msgid ""
"This device has no events assigned to it. Ask an administrator to grant it "
"access on the Devices page."
msgstr ""
"Tomuto zařízení nejsou přiřazeny žádné akce. Požádejte administrátora, aby "
"mu udělil přístup na stránce Zařízení."

#: pretix_pos/static/pretix_pos/pos.js:1070
#: pretix_pos/static/pretix_pos/pos.js:1076
msgid "Could not load the seating plan. Selling is temporarily unavailable."
msgstr ""

#: pretix_pos/static/pretix_pos/pos.js:1155
#: pretix_pos/static/pretix_pos/pos.js:2047
msgid "No items available."
msgstr "Nejsou k dispozici žádné položky."

#: pretix_pos/static/pretix_pos/pos.js:1195
msgid "%(count)s product with no seats in this plan"
msgid_plural "%(count)s products with no seats in this plan"
msgstr[0] "%(count)s produkt bez míst v tomto plánu"
msgstr[1] "%(count)s produkty bez míst v tomto plánu"
msgstr[2] "%(count)s produktů bez míst v tomto plánu"

#: pretix_pos/static/pretix_pos/pos.js:1276
msgid "Placing this — click seats"
msgstr "Usazuji tento — klikejte do mapy"

#: pretix_pos/static/pretix_pos/pos.js:1278
msgid "Seat this product (%(count)s)"
msgstr "Usadit tento produkt (%(count)s)"

#: pretix_pos/static/pretix_pos/pos.js:1279
msgid "Seat this product"
msgstr "Usadit tento produkt"

#: pretix_pos/static/pretix_pos/pos.js:1303
msgid "%(name)s (%(price)s) — seated"
msgstr "%(name)s (%(price)s) — se sezením"

#: pretix_pos/static/pretix_pos/pos.js:1315
#: pretix_pos/static/pretix_pos/pos.js:1348
msgid "%(count)s selected"
msgid_plural "%(count)s selected"
msgstr[0] "Vybráno: %(count)s"
msgstr[1] "Vybráno: %(count)s"
msgstr[2] "Vybráno: %(count)s"

#: pretix_pos/static/pretix_pos/pos.js:1316
msgid "Click its seats on the map"
msgstr "Klikejte na jeho místa v mapě"

#: pretix_pos/static/pretix_pos/pos.js:1328
msgid "%(name)s — seated, pick a variant"
msgstr "%(name)s — se sezením, vyberte variantu"

#: pretix_pos/static/pretix_pos/pos.js:1452
msgid ""
"This seat's category has no product mapped to it - choose a product with "
"“Seat this product” first."
msgstr ""
"Kategorie tohoto místa nemá namapovanou žádnou položku – zvolte nejdřív "
"produkt tlačítkem „Usadit tento produkt“."

#: pretix_pos/static/pretix_pos/pos.js:1457
msgid ""
"%(name)s has variants, so a seat can't tell which one - pick the variant "
"with “Seat this product” first."
msgstr ""
"%(name)s má varianty, takže z místa nelze poznat kterou – vyberte nejdřív "
"variantu tlačítkem „Usadit tento produkt“."

#: pretix_pos/static/pretix_pos/pos.js:1461
msgid "This seat can't be booked from here."
msgstr "Toto místo odsud nelze obsadit."

#: pretix_pos/static/pretix_pos/pos.js:1475
msgid "Placing: %(name)s - the seating plan's own mapping is ignored"
msgstr "Usazuji: %(name)s – mapování plánu se ignoruje"

#: pretix_pos/static/pretix_pos/pos.js:1480
msgid "Back to the mapping"
msgstr "Zpět na mapování"

#: pretix_pos/static/pretix_pos/pos.js:1527
#: pretix_pos/static/pretix_pos/pos.js:3780
msgid "No free seats left for this item/date."
msgstr "Pro tuto položku/termín nezbývá žádné volné místo."

#: pretix_pos/static/pretix_pos/pos.js:1564
msgid "Empty."
msgstr "Prázdný."

#: pretix_pos/static/pretix_pos/pos.js:1590
msgid "Remove"
msgstr "Odebrat"

#: pretix_pos/static/pretix_pos/pos.js:1670
msgid ""
"Could not match every seat to its position - assign the missing ones in the "
"Edit order tab."
msgstr ""
"Nepodařilo se přiřadit každé místo k jeho pozici – zbytek přiřaďte v záložce "
"Upravit objednávku."

#: pretix_pos/static/pretix_pos/pos.js:1678
msgid ""
"The order was created, but %(count)s seat(s) could not be assigned (%"
"(error)s) - finish it in the Edit order tab."
msgstr ""
"Objednávka byla vytvořena, ale %(count)s míst se nepodařilo přiřadit (%"
"(error)s) – dokončete to v záložce Upravit objednávku."

#: pretix_pos/static/pretix_pos/pos.js:1692
#: pretix_pos/static/pretix_pos/pos.js:2320
msgid "Searching existing reservations…"
msgstr "Vyhledávání existujících rezervací…"

#: pretix_pos/static/pretix_pos/pos.js:1697
#: pretix_pos/static/pretix_pos/pos.js:2325
msgid "Couldn't check existing reservations. Try again before reserving."
msgstr ""
"Nepodařilo se ověřit existující rezervace. Zkuste to před rezervací znovu."

#: pretix_pos/static/pretix_pos/pos.js:1704
#: pretix_pos/static/pretix_pos/pos.js:2332
msgid "Will add the selected tickets to order "
msgstr "Vybrané vstupenky budou přidány do objednávky "

#: pretix_pos/static/pretix_pos/pos.js:1709
#: pretix_pos/static/pretix_pos/pos.js:2337
msgid "The customer details on that order will not be changed."
msgstr "Údaje zákazníka v této objednávce se nezmění."

#: pretix_pos/static/pretix_pos/pos.js:1711
msgid "Will create a new order."
msgstr "Bude vytvořena nová objednávka."

#: pretix_pos/static/pretix_pos/pos.js:1716
#: pretix_pos/static/pretix_pos/pos.js:2344
msgid "Change"
msgstr "Změnit"

#: pretix_pos/static/pretix_pos/pos.js:1730
#: pretix_pos/static/pretix_pos/pos.js:2358
msgid "Matching orders found. Choose what to do:"
msgstr "Nalezeny odpovídající objednávky. Zvolte, co provést:"

#: pretix_pos/static/pretix_pos/pos.js:1734
msgid "Create a new order"
msgstr "Vytvořit novou objednávku"

#: pretix_pos/static/pretix_pos/pos.js:1744
#: pretix_pos/static/pretix_pos/pos.js:2372
msgid "Add to %(code)s (%(customer)s, %(count)s tickets, %(status)s)"
msgstr "Přidat do %(code)s (%(customer)s, %(count)s vstupenek, %(status)s)"

#: pretix_pos/static/pretix_pos/pos.js:1748
#: pretix_pos/static/pretix_pos/pos.js:2376
msgid "paid"
msgstr "zaplaceno"

#: pretix_pos/static/pretix_pos/pos.js:1748
#: pretix_pos/static/pretix_pos/pos.js:2376
msgid "pending"
msgstr "čeká na úhradu"

#: pretix_pos/static/pretix_pos/pos.js:1802
msgid "This order still needs seats before it can be sold."
msgstr "Tato objednávka ještě potřebuje usadit, než ji lze prodat."

#: pretix_pos/static/pretix_pos/pos.js:1838
#: pretix_pos/static/pretix_pos/pos.js:2490
msgid ""
"This order can no longer be changed here. Open it in Edit order to handle it."
msgstr ""
"Tuto objednávku už zde nelze upravit. Otevřete ji v záložce Upravit "
"objednávku."

#: pretix_pos/static/pretix_pos/pos.js:1840
msgid "Order change canceled."
msgstr "Změna objednávky byla zrušena."

#: pretix_pos/static/pretix_pos/pos.js:1859
msgid "Sold — order "
msgstr "Prodáno — objednávka "

#: pretix_pos/static/pretix_pos/pos.js:1859
#: pretix_pos/static/pretix_pos/pos.js:2431
msgid "Reserved — order "
msgstr "Rezervováno — objednávka "

#: pretix_pos/static/pretix_pos/pos.js:1870
#: pretix_pos/static/pretix_pos/pos.js:2443
msgid ", total %(total)s."
msgstr ", celkem %(total)s."

#: pretix_pos/static/pretix_pos/pos.js:1885
#: pretix_pos/static/pretix_pos/pos.js:2459
msgid ""
"Enter an e-mail or a name before reserving - otherwise there's no way to "
"find this order again later."
msgstr ""
"Před rezervací zadejte e-mail nebo jméno - jinak nebude možné tuto "
"objednávku později znovu najít."

#: pretix_pos/static/pretix_pos/pos.js:1897
#: pretix_pos/static/pretix_pos/pos.js:2463
msgid ""
"Can't reach the server to check whether this event is in test mode - reload "
"the page before selling."
msgstr ""
"Nelze u serveru ověřit, zda je akce v testovacím režimu – před prodejem "
"načtěte stránku znovu."

#: pretix_pos/static/pretix_pos/pos.js:1901
#: pretix_pos/static/pretix_pos/pos.js:2467
msgid "Wait for the existing-reservation search before reserving."
msgstr ""
"Před rezervací počkejte na dokončení vyhledávání existujících rezervací."

#: pretix_pos/static/pretix_pos/pos.js:1905
#: pretix_pos/static/pretix_pos/pos.js:2471
msgid ""
"Couldn't check existing reservations. Correct the customer details or try "
"again."
msgstr ""
"Nepodařilo se ověřit existující rezervace. Upravte údaje zákazníka nebo to "
"zkuste znovu."

#: pretix_pos/static/pretix_pos/pos.js:1909
#: pretix_pos/static/pretix_pos/pos.js:2475
msgid "Choose whether to create a new reservation or add to an existing one."
msgstr ""
"Zvolte, zda vytvořit novou rezervaci, nebo přidat vstupenky do existující."

#: pretix_pos/static/pretix_pos/pos.js:1915
#: pretix_pos/static/pretix_pos/pos.js:2480
msgid "Submitting…"
msgstr "Odesílání…"

#: pretix_pos/static/pretix_pos/pos.js:1933
msgid ""
"Some temporary seats could not be released. Check the order in Edit order."
msgstr ""
"Některá dočasně obsazená místa se nepodařilo uvolnit. Zkontrolujte "
"objednávku v záložce Upravit objednávku."

#: pretix_pos/static/pretix_pos/pos.js:2054
msgid "No dates available."
msgstr "Nejsou k dispozici žádné termíny."

#: pretix_pos/static/pretix_pos/pos.js:2064
msgid "Date"
msgstr "Termín"

#: pretix_pos/static/pretix_pos/pos.js:2128
msgid "Decrease quantity"
msgstr "Snížit počet"

#: pretix_pos/static/pretix_pos/pos.js:2130
msgid "Increase quantity"
msgstr "Zvýšit počet"

#: pretix_pos/static/pretix_pos/pos.js:2259
#: pretix_pos/static/pretix_pos/pos.js:2292
msgid ""
"Not enough free seats left for one of these dates/items - try a smaller "
"quantity."
msgstr ""
"Pro některou z těchto položek/termínů už není dostatek volných míst - zkuste "
"menší počet."

#: pretix_pos/static/pretix_pos/pos.js:2339
msgid "Will create a new reservation."
msgstr "Bude vytvořena nová rezervace."

#: pretix_pos/static/pretix_pos/pos.js:2362
msgid "Create a new reservation"
msgstr "Vytvořit novou rezervaci"

#: pretix_pos/static/pretix_pos/pos.js:2442
msgid ""
", total %(total)s - but couldn't release every placeholder seat, check the "
"Edit order tab."
msgstr ""
", celkem %(total)s - ale nepodařilo se uvolnit všechna zástupná místa, "
"zkontrolujte záložku Upravit objednávku."

#: pretix_pos/static/pretix_pos/pos.js:2450
msgid "Enter a quantity greater than zero for at least one item/date."
msgstr "Zadejte počet větší než nula alespoň pro jednu položku/termín."

#: pretix_pos/static/pretix_pos/pos.js:2578
msgid "Searching…"
msgstr "Vyhledávání…"

#: pretix_pos/static/pretix_pos/pos.js:2609
msgid "Load more orders"
msgstr "Načíst další objednávky"

#: pretix_pos/static/pretix_pos/pos.js:2695
msgid "no e-mail"
msgstr "bez e-mailu"

#: pretix_pos/static/pretix_pos/pos.js:2702
msgid "No matching orders."
msgstr "Žádné odpovídající objednávky."

#: pretix_pos/static/pretix_pos/pos.js:2722
msgid "total %(total)s"
msgstr "celkem %(total)s"

#: pretix_pos/static/pretix_pos/pos.js:2724
msgid "pending %(amount)s"
msgstr "čeká na úhradu %(amount)s"

#: pretix_pos/static/pretix_pos/pos.js:2730
msgid "credit %(amount)s"
msgstr "dluh %(amount)s"

#: pretix_pos/static/pretix_pos/pos.js:2813
msgid ""
"This order was created online. Check the price, payment status, and any "
"invoice before continuing."
msgstr ""
"Tato objednávka byla vytvořena online. Před pokračováním zkontrolujte cenu, "
"stav platby a případnou fakturu."

#: pretix_pos/static/pretix_pos/pos.js:2819
msgid "Item #%(id)s"
msgstr "Položka č. %(id)s"

#: pretix_pos/static/pretix_pos/pos.js:2849
msgid "Add a ticket"
msgstr "Přidat vstupenku"

#: pretix_pos/static/pretix_pos/pos.js:2898
msgid "Add"
msgstr ""

#: pretix_pos/static/pretix_pos/pos.js:2942
msgid "no seat"
msgstr "bez místa"

#: pretix_pos/static/pretix_pos/pos.js:2953
msgid "Cancel this position"
msgstr "Zrušit tuto pozici"

#: pretix_pos/static/pretix_pos/pos.js:3003
msgid "Click to switch to this date's seating plan."
msgstr "Kliknutím přepnete na plán sezení tohoto termínu."

#: pretix_pos/static/pretix_pos/pos.js:3070
msgid "Total: %(total)s"
msgstr "Celkem: %(total)s"

#: pretix_pos/static/pretix_pos/pos.js:3071
msgid " — pending: %(amount)s"
msgstr " — čeká na úhradu: %(amount)s"

#: pretix_pos/static/pretix_pos/pos.js:3072
msgid " — credit owed to customer: %(amount)s"
msgstr " — dluh vůči zákazníkovi: %(amount)s"

#: pretix_pos/static/pretix_pos/pos.js:3073
msgid " — fully paid"
msgstr " — plně uhrazeno"

#: pretix_pos/static/pretix_pos/pos.js:3086
msgid "Online order — changes affect the customer's existing order."
msgstr "Online objednávka — změny ovlivní stávající objednávku zákazníka."

#: pretix_pos/static/pretix_pos/pos.js:3096
msgid "Expired %(date)s - the seats are no longer held"
msgstr "Propadlo %(date)s – místa už nejsou držena"

#: pretix_pos/static/pretix_pos/pos.js:3098
msgid "Payment deadline passed %(date)s - waiting to expire"
msgstr "Platební termín %(date)s uplynul – čeká se na expiraci"

#: pretix_pos/static/pretix_pos/pos.js:3099
msgid "Valid until %(date)s"
msgstr "Platí do %(date)s"

#: pretix_pos/static/pretix_pos/pos.js:3114
msgid "Paid %(amount)s by %(method)s on %(date)s"
msgstr "Zaplaceno %(amount)s – %(method)s, %(date)s"

#: pretix_pos/static/pretix_pos/pos.js:3140
msgid "Record a refund"
msgstr "Zaznamenat vrácení"

#: pretix_pos/static/pretix_pos/pos.js:3141
msgid ""
"Only records that the money was returned to the customer - this does not "
"move any money itself."
msgstr ""
"Pouze zaznamená, že peníze byly zákazníkovi vráceny - terminál sám žádné "
"peníze nepřevádí."

#: pretix_pos/static/pretix_pos/pos.js:3182
msgid "Take payment"
msgstr "Přijmout platbu"

#: pretix_pos/static/pretix_pos/pos.js:3188
msgid "Assign a seat to every position (for every date) before taking payment."
msgstr ""
"Před přijetím platby přiřaďte místo ke každé pozici (pro každý termín)."

#: pretix_pos/static/pretix_pos/pos.js:3207
msgid "Show QR code"
msgstr "Zobrazit QR kód"

#: pretix_pos/static/pretix_pos/pos.js:3223
msgid "Payment received"
msgstr "Platba dorazila"

#: pretix_pos/static/pretix_pos/pos.js:3260
msgid "Revive until the event date"
msgstr "Obnovit do konání akce"

#: pretix_pos/static/pretix_pos/pos.js:3261
msgid "Extend to the event date"
msgstr "Prodloužit do konání akce"

#: pretix_pos/static/pretix_pos/pos.js:3277
msgid "Reactivate order"
msgstr "Obnovit objednávku"

#: pretix_pos/static/pretix_pos/pos.js:3295
msgid "Cancel entire order"
msgstr "Zrušit celou objednávku"

#: pretix_pos/static/pretix_pos/pos.js:3360
msgid ""
"This order's own seats (for the date selected above) are shown in a muted "
"highlight color. What clicking does depends on the checkboxes in the "
"position list: with positions checked you are placing seats, so clicks and "
"rectangle drags pick free seats; with nothing checked you are clearing "
"seats, so they pick this order's own seats instead. Either way the selection "
"is only staged - shown with a ring - until you press the button next to the "
"legend, and clicking empty space clears it. Drag one of this order's own "
"seats onto a free seat to move it (shown as a translucent preview while "
"dragging); hold Ctrl while dragging to move its whole block of seats "
"together. Hover any occupied seat to see which order holds it, or double-"
"click it to jump straight to that order. Positions for other dates are "
"listed above, greyed out - switch the date to work with them."
msgstr ""
"Vlastní místa této objednávky (pro termín vybraný výše) jsou zobrazena "
"tlumenou zvýrazňující barvou. Co udělá kliknutí, závisí na zaškrtávátkách v "
"seznamu pozic: když jsou pozice zaškrtnuté, usazujete, takže kliknutí i "
"přetažení obdélníku vybírají volná místa; když není zaškrtnuté nic, rušíte, "
"takže vybírají naopak vlastní místa této objednávky. Tak či tak je výběr "
"zatím jen připravený – zobrazí se obrysem – dokud nestisknete tlačítko vedle "
"legendy; kliknutím na prázdné místo výběr zrušíte. Přetažením některého z "
"vlastních míst na volné místo ho přesunete (během přetahování se zobrazí "
"poloprůhledný náhled); podržením klávesy Ctrl při přetahování přesunete celý "
"blok míst najednou. Najetím myší na obsazené místo zjistíte, které "
"objednávce patří, nebo na něj dvakrát klikněte a přejděte přímo na danou "
"objednávku. Pozice pro ostatní termíny jsou uvedeny výše, zešedlé – pro "
"práci s nimi přepněte termín."

#: pretix_pos/static/pretix_pos/pos.js:3382
msgid "free — shown in its own seating category's color"
msgstr "volné – barvou příslušné kategorie sezení"

#: pretix_pos/static/pretix_pos/pos.js:3384
msgid "unavailable"
msgstr "nedostupné"

#: pretix_pos/static/pretix_pos/pos.js:3385
msgid "this order's seats"
msgstr "místa této objednávky"

#: pretix_pos/static/pretix_pos/pos.js:3388
msgid "selected to place"
msgstr "vybráno k usazení"

#: pretix_pos/static/pretix_pos/pos.js:3392
msgid "selected to clear"
msgstr "vybráno ke zrušení"

#: pretix_pos/static/pretix_pos/pos.js:3401
msgid "Seats cannot be changed until this order is restored."
msgstr "Místa nelze měnit, dokud objednávku neobnovíte."

#: pretix_pos/static/pretix_pos/pos.js:3405
msgid "Choose a date above to place seats for that date."
msgstr "Vyberte termín výše, abyste mohli pro tento termín přiřazovat místa."

#: pretix_pos/static/pretix_pos/pos.js:3409
msgid "This date has no seated positions."
msgstr "Tento termín nemá žádné pozice se sezením."

#: pretix_pos/static/pretix_pos/pos.js:3454
msgid "Bank transfer"
msgstr "Bankovní převod"

#: pretix_pos/static/pretix_pos/pos.js:3482
msgid "Can't tell which date this order is for."
msgstr "Nelze zjistit, na který termín je objednávka."

#: pretix_pos/static/pretix_pos/pos.js:3486
msgid "Extending…"
msgstr "Prodlužuji…"

#: pretix_pos/static/pretix_pos/pos.js:3512
